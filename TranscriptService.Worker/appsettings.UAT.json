{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RecordingGrpcService": {
    "Address": ""
  },
  "RabbitMQ": {
    "Host": "",
    "Port": "5671",
    "VirtualHost": "",
    "Username": "",
    "Password": "",
    "PrefetchCount": 1
  },
  "Azure": {
    "StorageConnectionString": "",
    "SourceContainer": "audio-captures",
    "WavContainer": "wav-converts"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}
